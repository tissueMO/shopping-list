# Google Keep設定
KEEP_EMAIL=your-email@gmail.com
KEEP_MASTER_TOKEN=your-master-token-from-gpsoauth
KEEP_DEVICE_ID=your-device-id-from-gpsoauth
KEEP_LIST_TITLE=買い物リスト
NUXT_KEEP_API_URL=http://keep-api:8000

# OpenAI設定
NUXT_OPENAI_API_KEY=sk-your-openai-key
NUXT_OPENAI_MODEL=gpt-5-mini

# カテゴリー設定
NUXT_CATEGORIES="野菜・果物,鮮魚,精肉,惣菜,乳製品・加工食品,飲料,冷凍食品,調味料・日用品,お菓子"

# Redis設定
NUXT_REDIS_URL=redis://redis:6379
